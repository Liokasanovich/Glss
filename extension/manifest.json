{
  "manifest_version": 3,
  "name": "GLSS 视频超分辨率与帧插值",
  "version": "1.0.0",
  "description": "基于 WebGPU/WebGL 的实时视频超分辨率放大 (FSR+RCAS/Anime4K) 与运动补偿帧插值 (Nx) 浮窗播放插件",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GLSS 视频增强控制面板"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "renderer/*",
        "icons/*",
        "demo/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
